NODE_ENV=development

TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_TIMEOUT_MS=10000
# Health probes get a shorter budget so the status endpoint always answers fast.
TALLY_PROBE_TIMEOUT_MS=4000

LOG_LEVEL=info

# ---- Local MongoDB Mirror ----
# Set MONGODB_ENABLED=false to run without the mirror (reads go live to Tally).
MONGODB_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017/cfo_yantra
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# ---- Live Auto-Sync ----
# Tally has no push channel, so this is the polling interval. Only records
# whose content hash changed are written.
SYNC_ENABLED=true
SYNC_INTERVAL_MS=60000
SYNC_START_DELAY_MS=5000
SYNC_VOUCHERS=true
# Per-voucher ledger/inventory entries: required for item-level analysis,
# credit note sign correction, and the Sales/Purchase Reconciliation Statement.
SYNC_VOUCHER_ENTRIES=true
