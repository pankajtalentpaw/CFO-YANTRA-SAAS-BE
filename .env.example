# CFO Yantra - Tally Bridge Environment Configuration

NODE_ENV=development

# TallyPrime Host & Port (Default: 127.0.0.1:9000)
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_TIMEOUT_MS=10000
# Health probes get a shorter budget so the status endpoint always answers fast.
TALLY_PROBE_TIMEOUT_MS=4000

# Optional: Specific Company Name Context
TALLY_COMPANY_NAME=

# Structured Logging Level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- Local MongoDB Mirror -------------------------------------------------
# Optional. With MongoDB absent or MONGODB_ENABLED=false the bridge still works
# exactly as before, serving every read live from TallyPrime.
MONGODB_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017/cfo_yantra
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# ---- Live Auto-Sync -------------------------------------------------------
# TallyPrime has no push/webhook channel, so "live" means polling on this
# interval. Only records whose parser checksum changed are written.
SYNC_ENABLED=true
SYNC_INTERVAL_MS=60000
SYNC_START_DELAY_MS=5000
# Vouchers are the heavy part of a sync pass.
SYNC_VOUCHERS=true
# Ledger/inventory entries per voucher: much slower to pull, off by default.
SYNC_VOUCHER_ENTRIES=false
