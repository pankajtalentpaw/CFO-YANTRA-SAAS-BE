# Server Configuration
HOST=127.0.0.1
PORT=5000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (Relative to workspace root or absolute path)
DATABASE_URL=sqlite+aiosqlite:///../data/cfo_yantra.sqlite

# Security & Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# TallyPrime Loopback Configuration
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_TIMEOUT_MS=120000
TALLY_PROBE_TIMEOUT_MS=8000

# Concurrency & Background Processing
ENABLE_BACKGROUND_JOBS=false
WORKERS=1
